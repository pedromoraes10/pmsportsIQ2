# Copie este arquivo para .env e preencha os valores
# O arquivo .env NÃO deve ser commitado no git (já está no .gitignore)

# --- Sync local → Railway (modo híbrido) ---
# Preencha para sincronizar automaticamente cada scrape com o servidor de produção.
# Deixe em branco para rodar só local (sem sync).

# URL do seu servidor no Railway (sem barra no final)
SYNC_URL=https://pmsportsiq-production.up.railway.app

# Token secreto — deve ser o mesmo valor configurado em SYNC_TOKEN no Railway
SYNC_TOKEN=seu-token-secreto-aqui
